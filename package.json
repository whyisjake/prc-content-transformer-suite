{
	"name": "@prc/content-transformer-suite",
	"description": "PRC Content Transformer Suite — open-source WordPress plugins for content transformation, AI processing, Apple News, and email delivery",
	"version": "1.0.0",
	"license": "GPL-2.0-or-later",
	"private": true,
	"packageManager": "npm@10.9.2",
	"engines": {
		"node": ">=22.16.0",
		"npm": ">=10.9.2"
	},
	"workspaces": [
		"plugins/prc-scripts",
		"plugins/prc-icon-library",
		"plugins/prc-post-publish-pipeline",
		"plugins/prc-markdown-for-agents",
		"plugins/prc-pdf-extraction",
		"plugins/prc-content-transformer",
		"plugins/prc-audio-narration",
		"plugins/prc-apple-news",
		"plugins/prc-email-builder"
	],
	"scripts": {
		"build": "turbo run build",
		"dev": "turbo run build --watch",
		"env": "npx --yes @wordpress/env@11.13.0",
		"test:php": "npx --yes @wordpress/env@11.13.0 run tests-cli --env-cwd=wp-content/plugins/prc-audio-narration \"vendor/bin/phpunit\""
	},
	"devDependencies": {
		"turbo": "^2.0.0"
	}
}
