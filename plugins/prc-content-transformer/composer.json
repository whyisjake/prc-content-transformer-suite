{
	"name": "pewresearch/prc-content-transformer",
	"type": "wordpress-plugin",
	"description": "AI-powered content transformation middleware for PRC Platform.",
	"license": "GPL-2.0-or-later",
	"require": {
		"php": ">=8.2",
		"automattic/jetpack-autoloader": "^3.0",
		"woocommerce/action-scheduler": "^3.8"
	},
	"require-dev": {
		"phpunit/phpunit": "^9.6"
	},
	"config": {
		"allow-plugins": {
			"composer/installers": true,
			"automattic/jetpack-autoloader": true
		},
		"platform": {
			"php": "8.2.0"
		}
	}
}
