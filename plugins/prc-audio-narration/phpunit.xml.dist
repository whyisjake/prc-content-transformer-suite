<?xml version="1.0"?>
<phpunit
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/9.6/phpunit.xsd"
	bootstrap="tests/bootstrap.php"
	backupGlobals="false"
	colors="true"
	beStrictAboutOutputDuringTests="true"
	beStrictAboutTestsThatDoNotTestAnything="true"
	>
	<testsuites>
		<testsuite name="PRC Audio Narration Test Suite">
			<!-- Test files follow the WordPress test-*.php convention rather than
			     PHPUnit's default *Test.php suffix, so the suffix is widened and
			     the non-test support files are excluded explicitly. -->
			<directory suffix=".php">./tests/</directory>
			<exclude>./tests/bootstrap.php</exclude>
			<exclude>./tests/helpers</exclude>
			<exclude>./tests/stubs</exclude>
		</testsuite>
	</testsuites>
	<coverage processUncoveredFiles="true">
		<include>
			<directory suffix=".php">./includes</directory>
			<file>./prc-audio-narration.php</file>
		</include>
		<exclude>
			<directory>./tests</directory>
			<directory>./vendor</directory>
		</exclude>
	</coverage>
	<php>
		<ini name="error_reporting" value="32767"/>
		<ini name="display_errors" value="1"/>
	</php>
</phpunit>
